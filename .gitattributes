# IDE specific files
*.iml text
*.ipr text
*.iws text
.project text
.classpath text

# OS specific files
.DS_Store binary
Thumbs.db binary
desktop.ini binary

# Line ending normalization
*.java text eol=lf
*.kt text eol=lf
*.groovy text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
